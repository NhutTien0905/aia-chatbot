# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Reranker (Azure AI - Cohere)
RERANKER_API_KEY=your-reranker-api-key
RERANKER_ENDPOINT=https://your-endpoint.services.ai.azure.com/providers/cohere/v2/rerank
RERANKER_MODEL=Cohere-rerank-v4.0-fast

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CHROMA_PERSIST_DIR=./chroma_data
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_SESSION=2
MAX_PDF_PAGES=20

# OCR
OCR_LANGUAGES=en,vi

# Session
SESSION_EXPIRY_HOURS=24

# CORS
FRONTEND_URL=http://localhost:3000
